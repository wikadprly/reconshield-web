# Copy to `.env` and fill in real values. Never commit `.env`.
# All variables here are SERVER-ONLY. Do not prefix any secret with NEXT_PUBLIC_.

# MySQL 8.4 (kompatibel MariaDB 10.11+) connection string used by Prisma.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/reconshield"

# Python Random Forest inference/preprocessing service.
PYTHON_ML_API_URL=""

# MikroTik RouterOS REST API. Reached only from the server, never the browser.
MIKROTIK_API_URL=""
MIKROTIK_USERNAME=""
MIKROTIK_PASSWORD=""

# "true" => use clearly-labeled mock data when no live source is configured.
RECONSHIELD_USE_MOCK_DATA="true"

# RouterOS write path is OFF unless this is exactly "true". Keep it "false"
# during development; the app then reports "write dinonaktifkan" instead of
# pretending a tarpit was applied.
RECONSHIELD_ENABLE_ROUTER_WRITES="false"
RECONSHIELD_MAX_ROUTER_WRITES_PER_MINUTE="5"

# Background tarpit worker (A7/6.2 langkah 6). OFF unless exactly "true".
# When on, it polls new reconnaissance detections and either applies the tarpit
# (mode Automatic) or files an approval request (mode Manual). It still obeys
# RECONSHIELD_ENABLE_ROUTER_WRITES and the per-minute write limit above.
RECONSHIELD_ENABLE_WORKER="false"
RECONSHIELD_WORKER_INTERVAL_MS="10000"
