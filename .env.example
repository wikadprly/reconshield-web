# Copy to `.env` and fill in real values. Never commit `.env`.
# All variables here are SERVER-ONLY. Do not prefix any secret with NEXT_PUBLIC_.

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/reconshield?schema=public"

# Python Random Forest inference/preprocessing service.
PYTHON_ML_API_URL=""

# MikroTik RouterOS REST API. Reached only from the server, never the browser.
MIKROTIK_API_URL=""
MIKROTIK_USERNAME=""
MIKROTIK_PASSWORD=""

# "true" => use clearly-labeled mock data when no live source is configured.
RECONSHIELD_USE_MOCK_DATA="true"
