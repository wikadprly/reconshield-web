generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A classified network flow / incident.
model Detection {
  id              String        @id
  timestamp       DateTime
  sourceIp        String
  sourcePort      Int
  destinationIp   String
  destinationPort Int
  classification  String
  confidence      Float
  action          String
  status          String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  approvals       Approval[]
  tarpitEntries   TarpitEntry[]

  @@index([timestamp])
  @@index([sourceIp])
  @@index([status])
  @@index([classification])
  @@map("detections")
}

/// An address currently under Dynamic Tarpit mitigation.
model TarpitEntry {
  id          String     @id @default(cuid())
  ip          String     @unique
  detectedAt  DateTime
  duration    String
  addressList String
  status      String
  releasedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  detectionId String?
  detection   Detection? @relation(fields: [detectionId], references: [id])

  @@index([status])
  @@index([detectionId])
  @@map("tarpit_entries")
}

/// Status of an external dependency (MikroTik RouterOS, Random Forest service).
model ServiceStatus {
  name      String   @id
  detail    String
  status    String
  checkedAt DateTime @default(now())

  @@map("service_statuses")
}

/// Immutable administrator policy-change record.
model AuditEntry {
  id                String   @id @default(cuid())
  timestamp         DateTime
  administrator     String
  previousMode      String
  newMode           String
  reason            String?
  createdAt         DateTime @default(now())
  administratorId   String?
  administratorUser User?    @relation(fields: [administratorId], references: [id], onDelete: NoAction)

  @@index([timestamp])
  @@index([administratorId])
  @@map("audit_entries")
}

/// Administrator account. Passwords are stored only as a server-side hash.
model User {
  id               String       @id @default(cuid())
  username         String       @unique
  passwordHash     String
  role             String       @default("admin")
  createdAt        DateTime     @default(now())
  decidedApprovals Approval[]   @relation("ApprovalDecision")
  auditEntries     AuditEntry[]

  @@map("users")
}

/// Manual-mode approval request for a single detection.
model Approval {
  id             String    @id @default(cuid())
  detectionId    String
  proposedAction String
  status         String    @default("pending")
  requestedAt    DateTime  @default(now())
  decidedAt      DateTime?
  decidedById    String?
  reason         String?
  decidedBy      User?     @relation("ApprovalDecision", fields: [decidedById], references: [id], onDelete: NoAction)
  detection      Detection @relation(fields: [detectionId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([detectionId])
  @@index([decidedById])
  @@map("approvals")
}

/// Current mitigation mode (single-row configuration).
model MitigationSetting {
  id        String   @id @default("default")
  mode      String
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("mitigation_settings")
}

/// One point-in-time sample of the MikroTik router's /system/resource
/// telemetry, recorded whenever the web app reads it live. Feeds the
/// router health history chart.
model RouterSample {
  id              Int      @id @default(autoincrement())
  takenAt         DateTime @default(now())
  boardName       String
  routerOsVersion String
  cpuLoadPercent  Float
  usedMemPercent  Float
  freeMemMb       Float
  totalMemMb      Float
  uptime          String

  @@index([takenAt])
  @@map("router_samples")
}

/// Random Forest evaluation run produced by the Python service.
model ModelEvaluation {
  id           String              @id @default(cuid())
  modelName    String
  version      String
  accuracy     Float
  precision    Float
  recall       Float
  f1Score      Float
  trueNormal   Int
  falseThreat  Int
  missedThreat Int
  trueThreat   Int
  dataset      String?
  periodStart  DateTime?
  periodEnd    DateTime?
  samples      Int?
  evaluatedAt  DateTime
  features     FeatureImportance[]

  @@map("model_evaluations")
}

/// Feature importance entry belonging to a ModelEvaluation.
model FeatureImportance {
  id           String          @id @default(cuid())
  feature      String
  importance   Float
  evaluationId String
  evaluation   ModelEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, feature])
  @@map("feature_importances")
}
