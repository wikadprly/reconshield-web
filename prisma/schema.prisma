// ReconShield schema (MySQL 8.4, compatible with MariaDB 10.11+).
//
// Scaffolded for research purposes. The MySQL init migration is prepared in
// prisma/migrations/20261112000000_init_mariadb and `prisma/seed.mjs` loads
// sample data that mirrors the mock dataset. Fields mirror the domain types in
// src/types/security.ts. Do not add invented ML fields or metrics that are not
// produced by the Python service.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

/// A classified network flow / incident.
model Detection {
  id              String   @id
  timestamp       DateTime
  sourceIp        String
  sourcePort      Int
  destinationIp   String
  destinationPort Int
  classification  String
  confidence      Float
  action          String
  status          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  approvals     Approval[]
  tarpitEntries TarpitEntry[]
  evidence      Evidence?

  @@index([timestamp])
  @@index([sourceIp])
  @@index([status])
  @@index([classification])
  @@map("detections")
}

/// An address currently under (or previously under) Dynamic Tarpit mitigation.
/// `status`: Pending | Active | Released | Expired | Verified.
model TarpitEntry {
  id            String    @id @default(cuid())
  ip            String    @unique
  detectedAt    DateTime
  duration      String
  durationMinutes Int     @default(60)
  expiresAt     DateTime?
  addressList   String
  status        String
  releasedAt    DateTime?
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  detectionId   String?
  detection     Detection? @relation(fields: [detectionId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([detectionId])
  @@index([expiresAt])
  @@map("tarpit_entries")
}

/// Snapshot that justifies one classification decision. Stored as an explicit
/// "bukti klasifikasi" (evidence), not as a claim about Random Forest internals.
model Evidence {
  id               String   @id @default(cuid())
  detectionId      String   @unique
  detection        Detection @relation(fields: [detectionId], references: [id], onDelete: Cascade)
  flowDirection    String   @default("external_to_protected")
  features         Json
  featureCount     Int
  confidence       Float
  modelName        String
  modelVersion     String
  policyVersion    String
  policySnapshot   Json
  createdAt        DateTime @default(now())

  @@index([modelVersion])
  @@map("evidence")
}

/// Status of an external dependency (MikroTik RouterOS, Random Forest service).
model ServiceStatus {
  name      String   @id
  detail    String
  status    String
  checkedAt DateTime @default(now())

  @@map("service_statuses")
}

/// Immutable administrator policy-change record.
model AuditEntry {
  id                String   @id @default(cuid())
  timestamp         DateTime
  administrator     String
  previousMode      String
  newMode           String
  action            String   @default("policy_change")
  target            String?
  reason            String?
  createdAt         DateTime @default(now())
  administratorId   String?
  administratorUser User?    @relation(fields: [administratorId], references: [id], onDelete: NoAction)

  @@index([timestamp])
  @@index([administratorId])
  @@map("audit_entries")
}

/// Administrator account. Passwords are stored only as a server-side hash.
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())

  decidedApprovals Approval[]   @relation("ApprovalDecision")
  auditEntries     AuditEntry[]

  @@map("users")
}

/// Manual-mode approval request for a single detection.
model Approval {
  id             String    @id @default(cuid())
  detectionId    String
  proposedAction String
  status         String    @default("pending")
  requestedAt    DateTime  @default(now())
  decidedAt      DateTime?
  decidedById    String?
  reason         String?

  detection Detection @relation(fields: [detectionId], references: [id], onDelete: Cascade)
  decidedBy User?     @relation("ApprovalDecision", fields: [decidedById], references: [id], onDelete: NoAction)

  @@index([status])
  @@index([detectionId])
  @@index([decidedById])
  @@map("approvals")
}

/// Current mitigation policy (single-row configuration). Bounds are enforced
/// in the service layer: the policy is bounded by design, not optimised.
model MitigationSetting {
  id                 String   @id @default("default")
  mode               String
  confidenceThreshold Int     @default(85)
  durationMinutes    Int      @default(60)
  maxDurationMinutes Int      @default(360)
  maxActiveEntries   Int      @default(50)
  addressList        String   @default("reconshield-tarpit-active")
  updatedAt          DateTime @updatedAt
  updatedBy          String?

  @@map("mitigation_settings")
}

/// One point-in-time sample of the MikroTik router's /system/resource
/// telemetry. Feeds the router health history chart.
model RouterSample {
  id              Int      @id @default(autoincrement())
  takenAt         DateTime @default(now())
  boardName       String
  routerOsVersion String
  cpuLoadPercent  Float
  usedMemPercent  Float
  freeMemMb       Float
  totalMemMb      Float
  uptime          String

  @@index([takenAt])
  @@map("router_samples")
}

/// Random Forest evaluation run produced by the Python service.
model ModelEvaluation {
  id           String    @id @default(cuid())
  modelName    String
  version      String
  accuracy     Float
  precision    Float
  recall       Float
  f1Score      Float
  trueNormal   Int
  falseThreat  Int
  missedThreat Int
  trueThreat   Int
  dataset      String?
  periodStart  DateTime?
  periodEnd    DateTime?
  samples      Int?
  evaluatedAt  DateTime

  features FeatureImportance[]

  @@map("model_evaluations")
}

/// Feature importance entry belonging to a ModelEvaluation.
model FeatureImportance {
  id           String          @id @default(cuid())
  feature      String
  importance   Float
  evaluationId String
  evaluation   ModelEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, feature])
  @@map("feature_importances")
}
